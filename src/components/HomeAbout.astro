---
import HomeAboutApp from './react/HomeAbout';
import type { LocaleCode } from '../data/i18n/locales';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
---

<HomeAboutApp client:load locale={locale} />

<style is:global>
	.home-about {
		--about-accent: var(--accent);
		background: var(--bg);
		padding-block: clamp(1.5rem, 2.8vw, 2.25rem);
	}

	.home-about__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.35fr);
		gap: clamp(1.25rem, 2.5vw, 2rem);
		align-items: center;
	}

	.home-about__copy {
		display: flex;
		gap: 1.25rem;
		min-width: 0;
		align-self: center;
	}

	.home-about__accent {
		width: 4px;
		flex-shrink: 0;
		border-radius: 0;
		background: var(--about-accent);
		align-self: stretch;
		min-height: 100%;
	}

	.home-about__text {
		min-width: 0;
		padding-block: 0.15rem;
	}

	.home-about__text h2 {
		margin: 0 0 0.55rem;
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 1.8vw, 1.45rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--ink);
		text-transform: lowercase;
	}

	.home-about__text p {
		margin: 0 0 0.55rem;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.home-about__text p:last-child {
		margin-bottom: 0;
	}

	.home-about__links {
		color: var(--ink-muted);
	}

	.home-about__links a {
		color: var(--about-accent);
		font-weight: 700;
		text-decoration: none;
	}

	.home-about__links a:hover {
		color: var(--accent-hover);
	}

	.home-about__media {
		margin: 0;
		min-width: 0;
		width: 100%;
		align-self: center;
	}

	.home-about__frame {
		position: relative;
		overflow: hidden;
		border-radius: 10px;
		background: #000;
		width: 100%;
		aspect-ratio: 16 / 9;
		max-height: 22rem;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
	}

	.home-about__video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: #000;
	}

	.home-about__caption {
		margin: 0.4rem 0 0;
		font-size: 0.72rem;
		line-height: 1.35;
		text-align: left;
		color: var(--ink-faint);
	}

	@media (max-width: 960px) {
		.home-about__grid {
			grid-template-columns: 1fr;
			gap: 1.15rem;
		}

		.home-about__frame {
			max-height: 18rem;
		}
	}
</style>
