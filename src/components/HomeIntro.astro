---
import en from '../../public/locales/en/translation.json';
import { homePreviewVideo } from '../data/home-media';

const home = en.home;
const video = homePreviewVideo;
---

<section class="shell home-intro" aria-labelledby="home-about-title">
	<div class="home-intro__grid">
		<div class="home-intro__block">
			<h1 id="home-about-title" class="home-intro__title">{home.aboutTitle}</h1>
			<p>
				{home.aboutP1Before}
				<a href="/pricing/">{home.aboutStore}</a>
				{home.aboutP1Mid}
				<a href="/updates/">{home.aboutStatus}</a>
				{home.aboutP1After}
			</p>
			<p>
				{home.aboutP2Before}{' '}
				<a href="/tarkov-cheats/">{home.aboutPillar}</a>
				{home.aboutP2Mid}
				<a href="/tarkov-esp/">{home.aboutEsp}</a>
				{home.aboutP2Mid}
				<a href="/tarkov-aimbot/">{home.aboutAimbot}</a>
				{home.aboutP2Or}
				<a href="/updates/">{home.aboutUndetected}</a>
				{home.aboutP2After}
			</p>
		</div>

		<figure id="home-intro-video" class="home-intro__video-wrap">
			<video
				class="home-intro__video"
				controls
				preload="none"
				playsinline
				width={video.width}
				height={video.height}
				poster={video.poster}
				src={video.url}
			>
				<a href={video.url}>Download Tarkov cheats preview video</a>
			</video>
			<figcaption class="home-intro__video-caption">
				<a href={video.url} rel="noopener noreferrer">
					Watch Tarkov cheats preview
				</a>
			</figcaption>
		</figure>
	</div>
</section>

<style>
	.home-intro {
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-intro__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(220px, 360px);
		gap: clamp(1.25rem, 3vw, 2rem);
		align-items: start;
	}

	.home-intro__block {
		margin-inline: 0;
		padding-left: 0.85rem;
		border-left: 3px solid var(--magenta);
		text-align: left;
	}

	.home-intro__title {
		margin: 0 0 0.85rem;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.5vw, 1.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.25;
		color: var(--ink);
	}

	.home-intro p {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--ink-muted);
	}

	.home-intro p + p {
		margin-top: 0.75rem;
	}

	.home-intro a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home-intro a:hover {
		color: var(--ink);
	}

	.home-intro__video-wrap {
		margin: 0;
		width: 100%;
	}

	.home-intro__video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--line-soft);
		border-radius: var(--radius-md, 0.75rem);
		background: #000;
		object-fit: cover;
	}

	.home-intro__video-caption {
		margin: 0.45rem 0 0;
		font-size: 0.8125rem;
		text-align: left;
	}

	.home-intro__video-caption a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home-intro__video-caption a:hover {
		color: var(--ink);
	}

	@media (max-width: 768px) {
		.home-intro__grid {
			grid-template-columns: 1fr;
		}

		.home-intro__video-wrap {
			max-width: 420px;
		}
	}
</style>
