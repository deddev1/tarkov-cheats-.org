---
import en from '../../public/locales/en/translation.json';

const home = en.home;
---

<section class="home-intro shell" aria-labelledby="home-about-title">
	<h1 id="home-about-title" class="home-intro__title">{home.aboutTitle}</h1>
	<p>
		{home.aboutP1Before}
		<a href="/pricing/">{home.aboutStore}</a>
		{home.aboutP1Mid}
		<a href="/updates/">{home.aboutStatus}</a>
		{home.aboutP1After}
	</p>
	<p>
		{home.aboutP2Before}{' '}
		<a href="/tarkov-cheats/">{home.aboutPillar}</a>
		{home.aboutP2Mid}
		<a href="/tarkov-esp/">{home.aboutEsp}</a>
		{home.aboutP2Mid}
		<a href="/tarkov-aimbot/">{home.aboutAimbot}</a>
		{home.aboutP2Or}
		<a href="/updates/">{home.aboutUndetected}</a>
		{home.aboutP2After}
	</p>
</section>

<style>
	.home-intro {
		max-width: 42rem;
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-intro__title {
		margin: 0 0 0.85rem;
		padding-left: 0.85rem;
		border-left: 3px solid var(--magenta);
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.5vw, 1.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.25;
		color: var(--ink);
	}

	.home-intro p {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--ink-muted);
	}

	.home-intro p + p {
		margin-top: 0.75rem;
	}

	.home-intro a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home-intro a:hover {
		color: var(--ink);
	}
</style>
