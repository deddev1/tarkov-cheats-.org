---
interface Props {
	rating: number;
	class?: string;
}

const { rating, class: className = 'review-stars' } = Astro.props;
const clamped = Math.min(5, Math.max(0, rating));
const rounded = Math.round(clamped * 2) / 2;
const full = Math.floor(rounded);
const half = rounded - full >= 0.5;
const starPath =
	'M10 2.5l2.2 5.1 5.5.5-4.2 3.7 1.3 5.4L10 14.4 5.2 17.2l1.3-5.4L2.3 8.1l5.5-.5L10 2.5z';

const slots = Array.from({ length: 5 }, (_, index) => ({
	index,
	isFull: index < full,
	isHalf: index >= full && half && index === full,
}));
---

<span class={className} aria-hidden="true">
	{
		slots.map(({ index, isFull, isHalf }) => (
			<svg
				viewBox="0 0 20 20"
				fill={isFull ? 'currentColor' : 'none'}
				stroke="currentColor"
				stroke-width={isFull || isHalf ? 0 : 1.15}
				opacity={isFull || isHalf ? 1 : 0.3}
			>
				{isHalf ? (
					<>
						<defs>
							<clipPath id={`half-star-${index}-${rounded}`}>
								<rect x="0" y="0" width="10" height="20" />
							</clipPath>
						</defs>
						<path
							clip-path={`url(#half-star-${index}-${rounded})`}
							d={starPath}
							fill="currentColor"
							stroke="none"
						/>
						<path d={starPath} />
					</>
				) : (
					<path d={starPath} />
				)}
			</svg>
		))
	}
</span>

<style>
	.review-stars {
		display: inline-flex;
		gap: 0.1rem;
		color: var(--magenta-soft);
		vertical-align: middle;
	}

	.review-stars svg {
		width: 0.85rem;
		height: 0.85rem;
	}

	:global(.review-stars--card) {
		color: var(--accent-amber);
	}

	:global(.review-stars--card) svg {
		width: 0.78rem;
		height: 0.78rem;
	}
</style>
